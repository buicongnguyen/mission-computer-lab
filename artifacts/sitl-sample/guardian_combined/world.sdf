<?xml version="1.0"?>
<!-- Guardian scenarios: three x500s hold watch posts around a carrier-mounted station. This is a template: the
     runner writes each scenario's world with its threat models, post markers and jamming zone at the marker below
     (integration/guardian_layout.py). Each x500 also reports its true pose, for the station's independent
     position fix and for the acceptance checks. Obstacles match inspection.sdf. -->
<sdf version="1.9"><world name="guardian">
  <physics name="physics" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
  <gravity>0 0 -9.81</gravity><magnetic_field>6e-6 2.3e-5 -4.2e-5</magnetic_field>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
  <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
  <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>47.397971</latitude_deg><longitude_deg>8.546164</longitude_deg><elevation>0</elevation></spherical_coordinates>
  <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.62 0.76 0.9 1</background><shadows>true</shadows><grid>false</grid></scene>
  <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>
  <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.25 0.3 0.25 1</ambient><diffuse>0.33 0.42 0.32 1</diffuse></material></visual></link></model>
  <!-- The carrier's road: visual only. -->
  <model name="road"><static>true</static><pose>6 -1.5 0.004 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>18 2.4 0.008</size></box></geometry><material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material></visual></link></model>
  <model name="obstacle_1"><static>true</static><pose>4 3 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1</radius><length>6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1</radius><length>6</length></cylinder></geometry><material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.78 0.36 0.26 1</diffuse></material></visual></link></model>
  <model name="obstacle_2"><static>true</static><pose>6 6 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.1</radius><length>6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.1</radius><length>6</length></cylinder></geometry><material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.78 0.36 0.26 1</diffuse></material></visual></link></model>
  <model name="obstacle_3"><static>true</static><pose>2 7 3 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.8</radius><length>6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.8</radius><length>6</length></cylinder></geometry><material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.78 0.36 0.26 1</diffuse></material></visual></link></model>
  <model name="post_0"><static>true</static><pose>1 2 0.005 0 0 0</pose><link name="link"><visual name="visual"><transparency>0</transparency><geometry><cylinder><radius>0.6</radius><length>0.01</length></cylinder></geometry><material><ambient>0.1 0.7 0.6 1</ambient><diffuse>0.1 0.7 0.6 1</diffuse></material></visual></link></model>
  <model name="post_1"><static>true</static><pose>0 12 0.005 0 0 0</pose><link name="link"><visual name="visual"><transparency>0</transparency><geometry><cylinder><radius>0.6</radius><length>0.01</length></cylinder></geometry><material><ambient>0.95 0.7 0.2 1</ambient><diffuse>0.95 0.7 0.2 1</diffuse></material></visual></link></model>
  <model name="post_2"><static>true</static><pose>12 8 0.005 0 0 0</pose><link name="link"><visual name="visual"><transparency>0</transparency><geometry><cylinder><radius>0.6</radius><length>0.01</length></cylinder></geometry><material><ambient>0.55 0.45 0.95 1</ambient><diffuse>0.55 0.45 0.95 1</diffuse></material></visual></link></model>
  <model name="jamming_zone"><static>true</static><pose>1.5 3.5 0.005 0 0 0</pose><link name="link"><visual name="visual"><transparency>0.65</transparency><geometry><cylinder><radius>2.5</radius><length>0.01</length></cylinder></geometry><material><ambient>0.85 0.2 0.2 1</ambient><diffuse>0.85 0.2 0.2 1</diffuse></material></visual></link></model>
  <model name="intruder"><pose>-3.4 23.0 4.0 0 0.0 0.0</pose><link name="body"><gravity>false</gravity><inertial><mass>1.5</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="hull"><geometry><box><size>0.34 0.34 0.12</size></box></geometry><material><ambient>0.75 0.08 0.08 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual><visual name="arm_a"><pose>0 0 0.02 0 0 0.785</pose><geometry><box><size>0.9 0.05 0.03</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="arm_b"><pose>0 0 0.02 0 0 -0.785</pose><geometry><box><size>0.9 0.05 0.03</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_0"><pose>0.32 0.32 0.05 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.95 0.35 0.35 1</diffuse></material></visual><visual name="rotor_1"><pose>-0.32 0.32 0.05 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.95 0.35 0.35 1</diffuse></material></visual><visual name="rotor_2"><pose>0.32 -0.32 0.05 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.95 0.35 0.35 1</diffuse></material></visual><visual name="rotor_3"><pose>-0.32 -0.32 0.05 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.95 0.35 0.35 1</diffuse></material></visual></link><plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><topic>/model/intruder/cmd_vel</topic></plugin><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>intruder</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions></plugin></model>
  <model name="intruder_2"><pose>-5.4 23.5 3.0 0 0.0 0.0</pose><link name="body"><gravity>false</gravity><inertial><mass>1.5</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="hull"><geometry><box><size>0.34 0.34 0.12</size></box></geometry><material><ambient>0.75 0.08 0.08 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual><visual name="arm_a"><pose>0 0 0.02 0 0 0.785</pose><geometry><box><size>0.9 0.05 0.03</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="arm_b"><pose>0 0 0.02 0 0 -0.785</pose><geometry><box><size>0.9 0.05 0.03</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_0"><pose>0.32 0.32 0.05 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.95 0.35 0.35 1</diffuse></material></visual><visual name="rotor_1"><pose>-0.32 0.32 0.05 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.95 0.35 0.35 1</diffuse></material></visual><visual name="rotor_2"><pose>0.32 -0.32 0.05 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.95 0.35 0.35 1</diffuse></material></visual><visual name="rotor_3"><pose>-0.32 -0.32 0.05 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.95 0.35 0.35 1</diffuse></material></visual></link><plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><topic>/model/intruder_2/cmd_vel</topic></plugin><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>intruder_2</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions></plugin></model>
  <model name="bird_0"><pose>10.5 11.5 4.0 0 0.0 0.0</pose><link name="body"><gravity>false</gravity><inertial><mass>1.5</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="body"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.45 0.32 0.2 1</diffuse></material></visual><visual name="wings"><geometry><box><size>0.12 0.7 0.02</size></box></geometry><material><ambient>0.3 0.22 0.14 1</ambient><diffuse>0.4 0.3 0.18 1</diffuse></material></visual></link><plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><topic>/model/bird_0/cmd_vel</topic></plugin><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>bird_0</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions></plugin></model>
  <model name="bird_2"><pose>5.5 8.0 4.5 0 0.0 0.0</pose><link name="body"><gravity>false</gravity><inertial><mass>1.5</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="body"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.45 0.32 0.2 1</diffuse></material></visual><visual name="wings"><geometry><box><size>0.12 0.7 0.02</size></box></geometry><material><ambient>0.3 0.22 0.14 1</ambient><diffuse>0.4 0.3 0.18 1</diffuse></material></visual></link><plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><topic>/model/bird_2/cmd_vel</topic></plugin><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>bird_2</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions></plugin></model>
  <!-- Moving ground station: deck top at 0.6 m, pads at x = -1.1, 0, +1.1 in the carrier frame.
       VelocityControl drives it from /model/carrier/cmd_vel; OdometryPublisher reports its motion. -->
  <model name="carrier"><pose>0 -1.5 0 0 0 0</pose>
    <link name="base">
      <inertial><pose>0 0 0.3 0 0 0</pose><mass>2000</mass><inertia><ixx>487</ixx><iyy>1767</iyy><izz>2133</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="deck"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>3.2 1.6 0.6</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="deck"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>3.2 1.6 0.6</size></box></geometry><material><ambient>0.22 0.28 0.33 1</ambient><diffuse>0.26 0.33 0.4 1</diffuse></material></visual>
      <visual name="cab"><pose>1.95 0 0.55 0 0 0</pose><geometry><box><size>0.7 1.5 1.1</size></box></geometry><material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.9 0.6 0.18 1</diffuse></material></visual>
      <visual name="pad_0"><pose>-1.1 0 0.603 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>0.006</length></cylinder></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="pad_1"><pose>0 0 0.603 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>0.006</length></cylinder></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      <visual name="pad_2"><pose>1.1 0 0.603 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>0.006</length></cylinder></geometry><material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
    </link>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><topic>/model/carrier/cmd_vel</topic></plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>carrier</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions></plugin>
  </model>
  <!-- Overview of the posts, the intruder's line and the road (service /overview/record_video). -->
  <model name="overview_camera"><static>true</static><pose>4 -13 8 0 0.4 1.5708</pose>
    <link name="link"><sensor name="overview" type="camera"><always_on>1</always_on><update_rate>25</update_rate><topic>overview_camera</topic>
      <camera><horizontal_fov>1.0</horizontal_fov><image><width>960</width><height>540</height></image><clip><near>0.1</near><far>120</far></clip></camera>
      <plugin filename="gz-sim-camera-video-recorder-system" name="gz::sim::systems::CameraVideoRecorder"><service>/overview/record_video</service><use_sim_time>true</use_sim_time><fps>25</fps><bitrate>600000</bitrate></plugin>
    </sensor></link></model>
  <!-- Low close-up of the intruder's final approach, the post it passes and the carrier's escape (service /close/record_video). -->
  <model name="close_camera"><static>true</static><pose>-4 -10 4 0 0.2 1.1</pose>
    <link name="link"><sensor name="close" type="camera"><always_on>1</always_on><update_rate>25</update_rate><topic>close_camera</topic>
      <camera><horizontal_fov>1.0</horizontal_fov><image><width>960</width><height>540</height></image><clip><near>0.1</near><far>120</far></clip></camera>
      <plugin filename="gz-sim-camera-video-recorder-system" name="gz::sim::systems::CameraVideoRecorder"><service>/close/record_video</service><use_sim_time>true</use_sim_time><fps>25</fps><bitrate>600000</bitrate></plugin>
    </sensor></link></model>
  <include><uri>x500</uri><name>x500_0</name><pose>-1.1 -1.5 0.84 0 0 0</pose><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>x500_0</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions></plugin></include>
  <include><uri>x500</uri><name>x500_1</name><pose>0 -1.5 0.84 0 0 0</pose><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>x500_1</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions></plugin></include>
  <include><uri>x500</uri><name>x500_2</name><pose>1.1 -1.5 0.84 0 0 0</pose><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>x500_2</robot_base_frame><odom_publish_frequency>20</odom_publish_frequency><dimensions>3</dimensions></plugin></include>
</world></sdf>
